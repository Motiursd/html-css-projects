<!DOCTYPE html>
<html> 
    <head> 
        <title>My Project HTML and CSS</title>
        
        <style> 
            body { 
                background-color: #f0f4f8; 
                color: #333;
                font-family: Arial, sans-serif;
                margin: 0;
                padding: 40px 0;
            } 

            .card { 
                background-color: #ffffff; 
                color: #333; 
                width: 600px;
                margin: 0 auto; 
                padding: 40px; 
                border-radius: 20px; 
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
                transition: 0.4s ease; 
            } 

            .card:hover { 
                transform: translateY(-5px);
                box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
            } 

            h2 { 
                color: #111; 
                text-align: center; 
                margin: 30px 0 15px 0;
                font-size: 24px;
            } 

            .nav { 
                background-color: #f8f9fa; 
                margin: 15px 0; 
                padding: 10px; 
                border-radius: 12px; 
                transition: 0.3s;
                display: flex;
                justify-content: center;
                gap: 15px;
                border: 1px solid #e9ecef;
            } 

            .nav:hover { 
                background-color: #e2e6ea; 
            }

            .nav a { 
                color: #007bff; 
                text-decoration: none;
                font-weight: bold;
                padding: 8px 15px;
                border-radius: 8px;
                transition: 0.3s;
            } 

            .nav a:hover { 
                background-color: #007bff;
                color: white;
            } 

            /* প্যারাগ্রাফ */
            p { 
                color: #555;
                text-align: center; 
                margin: 10px 0;
                font-size: 16px;
            } 

            button { 
                background-color: #007bff;  
                color: white; 
                display: block; 
                width: 100%;
                text-align: center; 
                border: none;
                border-radius: 12px;
                margin: 20px auto; 
                padding: 12px 20px; 
                font-size: 16px;
                font-weight: bold;
                cursor: pointer;
                transition: 0.3s;
            }  

            button:hover { 
                background-color: tomato; 
                transform: scale(1.02);
            } 
        </style>
    </head>

    <body> 
        <div class="card">
            <h2>MY PROJECT</h2> 
            
            <div class="nav"> 
                <a href="#">HOME</a>
                <a href="#">About</a>
                <a href="#">Services</a>
                <a href="#">Contact</a>
            </div>

            <p>Hello, I am Motiur Rahman</p>
            <p>Frontend Developer</p> 
            <p>I create modern website</p> 

            <button>Hire Me</button>

            <h2>About Me</h2>
            <p>I am a CSE Student learning web</p>
            <p>Development and building website</p>
           
            <h2>My Services</h2>

            <div class="nav"> 
                <a href="#">HTML Services</a>
            </div>
          
            <div class="nav"> 
                <a href="#">CSS Services</a>
            </div>
          
            <div class="nav"> 
                <a href="#">Website Services</a>
            </div> 

            <h2>Contact</h2>
            <button>Contact Me</button>
        </div> 
    </body>
</html>
