<!DOCTYPE html>
<html> 
    <head> 
        <title>My Project HTML and CSS</title>
        
        <style> 
            body { 
                background-color: red; 
                color: black;
                margin: 0;
                padding: 40px 20px;
            } 

            .card { 
                background-color: white; 
                color: black; 
                width: 600px;
                margin: 0 auto; 
                padding: 40px; 
                border-radius: 20px; 
                transition: 0.4s; 
            } 

            .card:hover { 
                transform: scale(1.030);
            } 

            h2 { 
                color: black; 
                text-align: center; 
                margin: 20px 30px; 
                padding: 5px;
            } 

            .nav { 
                background-color: white; 
                margin: 15px 0px; 
                padding: 10px 0px; 
                border-radius: 12px; 
                transition: 0.3s;
                display: flex;
                justify-content: center;
                gap: 15px;
            } 

            .nav:hover { 
                background-color: azure; 
            }

            .nav a { 
                color: #007bff; 
                text-decoration: none;
                font-weight: bold;
                padding: 8px 15px;
                border-radius: 8px;
                transition: 0.3s;
            } 

            .nav a:hover { 
                background-color: blue;
                color: white;
            } 

            p { 
                color: black;
                text-align: center; 
                margin: 10px 0;
            } 

            button { 
                background-color: blue;  
                color: white; 
                display: block; 
                width: 100%;
                text-align: center; 
                border: none;
                border-radius: 12px;
                margin: 20px auto; 
                padding: 12px 20px; 
                font-size: 17px;
                font-weight: bold;
                cursor: pointer;
                transition: 0.3s;
            }  

            button:hover { 
                background-color: tomato; 
                transform: scale(1.02);
            }  

           
            .profile-img-container {
                text-align: center;
                margin-top: 30px;
                margin-bottom: 10px;
            }

            .profile-img {
                width: 150px;       
                height: 150px;        
                object-fit: cover;    
                border-radius: 50%; 
                border: 4px solid blue; 
                box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2); 
                transition: transform 0.3s;
            }

            .profile-img:hover {
                transform: scale(1.08); 
            }
        </style>
    </head>

    <body> 
        <div class="card">
            <h2>MY PROJECT</h2> 
            
            <div class="nav"> 
                <a href="#">HOME</a>
                <a href="#">About</a>
                <a href="#">Services</a>
                <a href="#">Contact</a>
            </div>

            <p>Hello, I am Motiur Rahman</p>
            <p>Frontend Developer</p> 
            <p>I create modern website</p> 

            <button>Hire Me</button>

            <h2>About Me</h2>
            <p>I am a CSE Student learning web</p>
            <p>Development and building website</p>
           
            <h2>My Services</h2>

            <div class="nav"> 
                <a href="#">HTML Services</a>
            </div>
          
            <div class="nav"> 
                <a href="#">CSS Services</a>
            </div>
          
            <div class="nav"> 
                <a href="#">Website Services</a>
            </div> 

            <h2>Contact</h2>
            <button>Contact Me</button>

           
            <div class="profile-img-container">
                <img src="motiur.jpg" alt="Profile Image" class="profile-img">
            </div>
        </div> 
    </body>
</html>
